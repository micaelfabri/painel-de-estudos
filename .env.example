# Copie para .env e preencha. O .env nunca vai para o git.
# Caminho do banco dentro do container (volume ./data)
PAINEL_DB_PATH=/app/data/painel.db
# Fase 5 (integrações) — preencher só quando chegar lá
NOTION_TOKEN=

# Hosts aceitos no cabeçalho Host (proteção contra DNS rebinding). Padrão: localhost,127.0.0.1
# PAINEL_ALLOWED_HOSTS=localhost,127.0.0.1

# v1.3 (SPEC D18): pasta de materiais do curso que o agente pode ler (só leitura), para as notas pelos prints.
# Use barras normais. Nada fora desta pasta é lido.
# PAINEL_MATERIALS_HOST=D:/Estudos/Minha Faculdade
